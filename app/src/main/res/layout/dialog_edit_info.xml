<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_name" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="textPersonName" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_student_id" />

        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_student_id"
            android:inputType="number" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_phone" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_phone"
            android:inputType="phone" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_email" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_gender" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_male" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/gender_female" />
        </RadioGroup>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_hobby" />

        <CheckBox
            android:id="@+id/cbTravel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hobby_travel" />

        <CheckBox
            android:id="@+id/cbReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hobby_reading" />

        <CheckBox
            android:id="@+id/cbGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hobby_game" />

        <CheckBox
            android:id="@+id/cbShopping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hobby_shopping" />

    </LinearLayout>
</ScrollView>
